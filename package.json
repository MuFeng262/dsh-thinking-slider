{
  "name": "dsh-thinking-slider",
  "version": "0.4.4",
  "description": "Three visual modes for picking a model's reasoning level in the DeepSeek Harness composer: hand back to the native selector, a gradient particle rail, or an energy-charging track. The levels themselves come from DSH.",
  "type": "module",
  "license": "MIT",
  "author": "MuFeng262",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "reasoning-effort",
    "thinking-level",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuFeng262/dsh-thinking-slider.git"
  },
  "homepage": "https://github.com/MuFeng262/dsh-thinking-slider#readme",
  "bugs": {
    "url": "https://github.com/MuFeng262/dsh-thinking-slider/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
